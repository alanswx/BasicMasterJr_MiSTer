# --- kept locally for research, deliberately not redistributed --------------
# Third-party source checkouts used only for cross-referencing.
mame/
ref/emulators/bm2/
ref/emulators/common-src-project/

# bm2 itself is a whole third-party emulator; we only ever read it. The pristine
# upstream tarball is kept instead, and ref/notes/ cites it by file and line.
ref/emulators/bm2_official/

# Build products of the vendored tape converter.
ref/emulators/bmtape2/bmtape2/*.o
ref/emulators/bmtape2/bmtape2/bmtape2

# Scanned manual, factory schematics and mirrored web pages. These are other
# people's documents; ref/README.md lists where each one came from so anyone
# can fetch their own copy.
ref/docs/

# Tape images. Third-party software with unverified redistribution rights (the
# inufuto games state no licence). software/README.md documents exactly where to
# download them and how to convert them, and software/bmtape_info.py verifies
# what you get. The magazine type-ins in software/typein/ are tracked: they were
# published as listings for readers to type in.
software/inufuto/

# Magazine page scans. Each type-in's .md names the archive.org item and leaves
# to fetch them again.
software/found2/micombasic_archive_org/*/
software/found2/typingtaskforce_gamingalexandria/*Page Scans*

# Python bytecode
__pycache__/
*.pyc
